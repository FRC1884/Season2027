{
  "schema_version": 3,
  "repository": "FRC1884/Season2027",
  "review_mode": "manual_codex_session",
  "promotion_flow": [
    "task/* -> relevant sub-lead branch",
    "sub-lead branch -> software-leads",
    "software-leads -> main"
  ],
  "branches": {
    "main": {
      "protected": true,
      "required_checks": ["build-and-format"],
      "require_pull_request": true,
      "require_code_owner_review": true,
      "required_approvals": 1,
      "allow_force_push": false,
      "allow_deletion": false
    },
    "software-leads": {
      "protected": true,
      "required_checks": ["build-and-format"],
      "require_pull_request": true,
      "require_code_owner_review": true,
      "required_approvals": 1,
      "allow_force_push": false,
      "allow_deletion": false
    },
    "vision-localisation-lead": {
      "protected": true,
      "owner_team": "@FRC1884/vision-localisation-lead",
      "required_checks": ["build-and-format"],
      "require_pull_request": true,
      "required_approvals": 1,
      "allow_force_push": false,
      "allow_deletion": false
    },
    "core-mechanisms-lead": {
      "protected": true,
      "owner_team": "@FRC1884/core-mechanisms-lead",
      "required_checks": ["build-and-format"],
      "require_pull_request": true,
      "required_approvals": 1,
      "allow_force_push": false,
      "allow_deletion": false
    },
    "autonomous-lead": {
      "protected": true,
      "owner_team": "@FRC1884/autonomous-lead",
      "required_checks": ["build-and-format"],
      "require_pull_request": true,
      "required_approvals": 1,
      "allow_force_push": false,
      "allow_deletion": false
    }
  },
  "review_groups": {
    "mentors": "@FRC1884/mentors",
    "software_leads": "@FRC1884/software-lead",
    "vision_localisation_lead": "@FRC1884/vision-localisation-lead",
    "core_mechanisms_lead": "@FRC1884/core-mechanisms-lead",
    "autonomous_lead": "@FRC1884/autonomous-lead",
    "approved_alumni": "@FRC1884/approved-alumni-reviewers"
  },
  "protected_paths": [
    ".github/workflows/**",
    ".github/CODEOWNERS",
    ".github/robotics-harness/**",
    ".codex/**",
    "AGENTS.md",
    "build.gradle",
    "settings.gradle",
    "src/main/java/**/safety/**",
    "src/main/java/**/*Constants.java",
    "src/main/deploy/**"
  ],
  "codex_review": {
    "automatic_github_ai_workflow": false,
    "user_invocation": "review PR #<number>",
    "policy_file": ".github/robotics-harness/REVIEW_POLICY.md",
    "output_template": ".github/robotics-harness/REVIEW_TEMPLATE.md",
    "reviewer_role": "Automated Reviewer",
    "require_fresh_context": true,
    "bind_to_head_sha": true,
    "human_merge_authority_only": true
  },
  "automated_deploy_allowed": false
}
